# Comma-separated long-lived keys for other projects
API_KEYS=dev-api-key-change-me

# Shared with apps/web — signs short-lived UI upload JWTs
UI_TOKEN_SECRET=dev-ui-token-secret-change-me

# Primary browser origin for CORS. Production also always allows
# https://www.rembg.site, https://rembg.site, and the Vercel project URL.
WEB_ORIGIN=http://localhost:3000

# Optional: comma-separated extra CORS origins (preview deployments, etc.)
# EXTRA_CORS_ORIGINS=https://remove-bg-saars-projects-d2973f9d.vercel.app

# Default rembg session. Callers may override via multipart field `model`
# (must be in ALLOWED_MODELS). On the Oracle VM prefer isnet-general-use for
# speed; birefnet-general remains available for quality.
MODEL=isnet-general-use

# ALLOWED_MODELS=isnet-general-use,birefnet-general

# Neon Postgres (optional for dashboard / DB-backed keys)
DATABASE_URL=

# Per-project daily cap for POST /v1/remove (UTC day). Default 50.
# Counted from usage_events for the authenticated project (API keys, web-ui
# JWTs, and legacy keys). If the count cannot be read, the API fails open.
# DAILY_QUOTA_PER_PROJECT=50
