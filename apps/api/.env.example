# Comma-separated long-lived keys for other projects
API_KEYS=dev-api-key-change-me

# Shared with apps/web — signs short-lived UI upload JWTs
UI_TOKEN_SECRET=dev-ui-token-secret-change-me

# Browser origin allowed for CORS (Vercel URL in production)
WEB_ORIGIN=http://localhost:3000

# Optional: comma-separated extra CORS origins
# EXTRA_CORS_ORIGINS=

MODEL=birefnet-general
